# Generate a long random value, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
DATABASE_PATH=./pocketsmart.sqlite3
# Optional: enables Gemini-generated commentary; catalog and prices remain illustrative.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
COOKIE_SECURE=false
